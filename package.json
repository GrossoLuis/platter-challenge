{
  "name": "platter-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Best Sellers product carousel built with semantic HTML, Tailwind CSS v4 and vanilla JS.",
  "author": "Grosso Luis",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "build:shopify": "tailwindcss -i ./src/shopify.css -o ./shopify/assets/best-sellers.css --minify",
    "serve": "serve ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3"
  }
}
